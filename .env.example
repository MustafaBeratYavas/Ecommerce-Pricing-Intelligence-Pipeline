# Copy to .env for local Docker Desktop runs.
APP_ENV=docker
TZ=Europe/Istanbul

# Container workflow:
#   run      -> create profile, seed product_codes.txt, run scraper
#   scrape   -> run scraper without reseeding
#   analysis -> regenerate reports from database/scraper.db
#   seed     -> seed database only
#   profile  -> create browser profile only
#   test     -> run unit tests inside the image
APP_COMMAND=run
SEED_FILE=product_codes.txt

# Nested config overrides use PRICING_PIPELINE__<section>__<key>.
PRICING_PIPELINE__browser__headless=true
PRICING_PIPELINE__browser__page_load_timeout=45
PRICING_PIPELINE__browser__implicit_wait=5
PRICING_PIPELINE__browser__captcha_auto_click=false
PRICING_PIPELINE__scraping__retries=3

# Bind-mounted runtime locations.
PRICING_PIPELINE__paths__database=database/scraper.db
PRICING_PIPELINE__paths__logs_dir=logs
PRICING_PIPELINE__paths__reports_dir=reports
PRICING_PIPELINE__paths__charts_dir=reports/charts
