# Python bytecode and native build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so

# Python packaging outputs
build/
dist/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments and local environment files
.venv/
venv/
env/
.env
.env.*
!.env.example

# IDE and editor metadata
.vscode/*
!.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.project
.settings/
*.swp
*.swo
*~

# Test, lint, type-check, and coverage outputs
.pytest_cache/
.pytest_tmp*/
.ruff_cache/
.pre-commit-cache/
.pyright/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# Application runtime data
.browser_profile/
downloaded_files/
logs/*
!logs/.gitkeep

# Local database files; keep the canonical analytics warehouse versioned
*.db
!database/scraper.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
!database/.gitkeep

# Temporary and local diagnostic files
*.log
*.tmp
_test_output.txt
_test_output/
test_results.txt

# Operating system metadata
Thumbs.db
.DS_Store
desktop.ini
