root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 88

[*.{yaml,yml}]
indent_size = 2

[*.toml]
indent_size = 4

[*.json]
indent_size = 2

[*.html]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = tab

[*.{bat,cmd}]
end_of_line = crlf
indent_size = 4

[*.sh]
end_of_line = lf
indent_size = 4

[*.{png,db,db-wal,db-shm,sqlite,sqlite3}]
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
